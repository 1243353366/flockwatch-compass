{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "corpora.investigation-workstation.v1",
  "productPromise": "Turn fragmented observations into defensible investigations.",
  "humanResponsibilities": [
    "define scope and objective",
    "authorize collection and controlled experiments",
    "review evidence and competing explanations",
    "approve reversible defensive actions",
    "preserve legal and operational accountability",
    "accept residual uncertainty"
  ],
  "aiResponsibilities": [
    "retrieve relevant evidence",
    "verify provenance and quality",
    "correlate observations without overclaiming",
    "challenge hypotheses",
    "propose bounded experiments",
    "explain observed, correlated, and inferred claims",
    "recommend next evidence and defensive options",
    "preserve provenance and uncertainty"
  ],
  "reasoningLoop": ["RETRIEVE", "VERIFY", "CORRELATE", "CHALLENGE", "HYPOTHESIZE", "TEST", "EXPLAIN", "RECOMMEND", "PRESERVE_PROVENANCE"],
  "claimLevels": ["OBSERVED", "CORRELATED", "INFERRED", "UNKNOWN"],
  "requiredHypothesisFields": ["supportingEvidence", "contradictingEvidence", "alternativeExplanations", "missingEvidence", "confidence"],
  "requiredActionFields": ["action", "reason", "evidence", "risk", "reversible", "authorization", "confidence"],
  "telemetryRule": "Telemetry unavailable must never be presented as no suspicious activity.",
  "simulationRule": "Experiments use predefined harmless synthetic tasks in an authorized isolated range.",
  "authorityRule": "The AI recommends; humans authorize high-impact actions.",
  "reportSections": ["incidentTimeline", "evidenceInventory", "detectionPerformance", "rootCauseHypotheses", "mitigationHistory", "auditTrail", "uncertaintyAndLimitations"]
}
