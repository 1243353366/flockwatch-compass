{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "corpora.evidence-governance.v1",
  "principle": "Preserve conditions that support authentication and review; do not claim admissibility or compliance.",
  "evidenceStatuses": ["ORIGINAL", "FORENSIC_COPY", "DUPLICATE", "DERIVED", "SUMMARY", "ANALYST_NOTE", "SYNTHETIC", "UNKNOWN"],
  "integrity": {"hashAlgorithm": "SHA-256", "preserveOriginal": true, "neverOverwriteOriginal": true, "derivedArtifactsLinkToOriginal": true, "verificationFailure": "EVIDENCE_INTEGRITY_FAILED"},
  "requiredArtifactMetadata": ["evidenceId", "hash", "hashAlgorithmVersion", "acquisitionTimestamp", "observationTimestamp", "ingestionTimestamp", "collectorIdentity", "collectorVersion", "acquisitionMethod", "sourceSystem", "sourceIdentifier", "size", "mimeType", "transformationHistory", "exportHistory", "derivativeOf", "evidenceStatus"],
  "custodyEventFields": ["evidenceId", "eventId", "actor", "authenticatedIdentity", "role", "timestamp", "action", "reason", "source", "destination", "hashBefore", "hashAfter", "verificationResult", "authorizationContext", "caseId", "relatedTicket", "origin"],
  "custodyActions": ["COLLECTED", "HASHED", "STORED", "VERIFIED", "ACCESSED", "EXPORTED", "COPIED", "REVIEWED", "SEALED", "DELETED_UNDER_POLICY"],
  "claimLevels": ["OBSERVED_FACT", "AUTHENTICATED_EVIDENCE", "DERIVED_DATA", "INFERENCE", "HYPOTHESIS", "ATTRIBUTION"],
  "legalProfiles": {
    "UNITED_STATES": {"status": "LEGAL_INFORMATION", "review": "COUNSEL_REVIEW_RECOMMENDED", "references": ["FRE 901", "FRE 1001-1004", "FRE 803(6) where applicable"]},
    "MICHIGAN": {"status": "LEGAL_INFORMATION", "review": "COUNSEL_REVIEW_REQUIRED_WHEN_FACT_DEPENDENT", "references": ["MRE 901", "MRE 1001-1004", "Michigan electronic-record and authentication authorities"]},
    "FEDERAL_UNKNOWN": {"status": "FEDERAL_JURISDICTION_UNKNOWN", "review": "COUNSEL_REVIEW_RECOMMENDED"},
    "EUROPEAN_DATA_PROTECTION": {"status": "EUROPEAN_DATA_PROTECTION_MODE", "complianceClaim": false, "controls": ["purpose limitation", "data minimization", "storage limitation", "integrity and confidentiality", "accountability", "access control", "encryption", "pseudonymization where appropriate", "retention policy", "deletion workflow", "data subject workflow", "processor/controller role", "legal-basis record", "cross-border transfer configuration"]}
  },
  "authorizationGate": ["targetOwnership", "authorized", "scopeDefined", "rulesOfEngagement", "timeWindow", "thirdPartySystem", "dataProcessingAuthority", "legalReviewRequired"],
  "retention": "CUSTOMER_POLICY_OR_LEGAL_REVIEW_REQUIRED",
  "legalHold": ["created", "authority", "createdBy", "createdAt", "scope", "affectedEvidence", "retentionOverride", "releasedBy", "releasedAt"],
  "disclaimer": "Legal information and evidence-management metadata only. Hashing and chain-of-custody records support review and authentication but do not guarantee admissibility, compliance, or legal outcomes."
}
